# 텍스트 파일 LF 강제 (Windows에서 CRLF 오염 방지)
* text=auto eol=lf

# Unity YAML 계열 (반드시 텍스트 + LF)
*.meta       text eol=lf
*.unity      text eol=lf
*.prefab     text eol=lf
*.asset      text eol=lf
*.mat        text eol=lf
*.anim       text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.physicMaterial     text eol=lf
*.shadergraph        text eol=lf
*.shadersubgraph     text eol=lf
*.inputactions       text eol=lf

# 코드
*.cs   text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.xml  text eol=lf
*.txt  text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.sh   text eol=lf

